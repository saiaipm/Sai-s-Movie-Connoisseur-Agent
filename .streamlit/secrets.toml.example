# Streamlit Community Cloud secrets.
#
# Do NOT commit the real secrets.toml — it is gitignored. Paste this content
# into the app's Settings -> Secrets box in the Streamlit Cloud dashboard,
# with your real values filled in.
#
# IMPORTANT: every plain key must appear ABOVE the [auth] section. In TOML,
# anything after a [table] header belongs to that table — a key placed below
# would become auth.google.WHATEVER and the app would never see it.

# --- Model (NVIDIA NIM: free to run) ---
# While writes are disabled, the app forces this provider regardless of what is
# set here, so a typo cannot start billing you.
MODEL_PROVIDER = "nvidia"
NVIDIA_API_KEY = "nvapi-..."

# Do NOT put OPENAI_API_KEY or a Gemini key in a public deployment's secrets.
# They are not needed, and keeping them out is the simplest protection.

# --- Write access ---
# DO NOT set WRITE_ENABLED here. Writing is off unless explicitly enabled, so
# leaving it out is what keeps a public deployment read-only. Omitting it also
# caps messages at 10 per session and forces the free model provider.
#
# Setting WRITE_ENABLED = "true" on a public app would let any visitor write to
# your spreadsheet. Use OWNER_EMAIL below instead.

# --- Owner sign-in ---
# The Google account that gets full read/write access after signing in.
# Everyone else stays read-only. This is how you use the app yourself, from any
# device, without opening your spreadsheet to the public.
OWNER_EMAIL = "you@example.com"

# --- TMDB ---
TMDB_API_KEY = "..."

# --- OMDb (omdbapi.com/apikey.aspx, free tier) ---
# Supplies the IMDb, Rotten Tomatoes and Metacritic columns. Optional, but
# omitting it does not raise: those columns are just silently left blank on
# anything logged from the deployed app, while IMDb_ID still populates from
# TMDB. Easy to miss, so set it.
OMDB_API_KEY = "..."

# --- Google Sheets ---
SPREADSHEET_KEY = "..."

# The whole service account JSON, inline.
#
# Use ''' (triple SINGLE quotes), not """ (triple double quotes). TOML treats
# """ as a basic string and expands the \n escapes inside private_key into real
# newlines, which makes the JSON invalid. ''' is a literal string and leaves
# them alone.
GOOGLE_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/..."
}
'''


# =============================================================================
# Everything below is a TOML table. Keep it LAST — see the note at the top.
# Omit this whole block if you do not want sign-in; the app then has no
# "Sign in" button and stays read-only for everyone.
# =============================================================================

[auth]
# Must exactly match your deployed app URL with /oauth2callback appended, and be
# listed as an Authorized redirect URI on the Google OAuth client.
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
# Any long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
