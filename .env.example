# Copy to .env and fill in. Never commit the filled-in .env.

# Google AI Studio key for the Gemini models driving the agents.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# ADK reads GOOGLE_GENAI_USE_VERTEXAI to choose AI Studio vs Vertex. Keep FALSE
# for the AI Studio key above.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Model selection ---
# MODEL_PROVIDER: "nvidia" (default), "gemini", or "openai".
# Default is NVIDIA NIM because it is free to run.
# MODEL_PROVIDER=nvidia
#
# Defaults per provider:
#   nvidia -> nvidia/nvidia-nemotron-nano-9b-v2  (free, 5/6 routing)
#   gemini -> gemini-3.1-flash-lite              (6/6 routing, quota-limited)
#   openai -> gpt-4o-mini                        (billed)
# MODEL_NAME=

# Required when MODEL_PROVIDER=nvidia (the default).
# Free key from build.nvidia.com -> any model page -> "Get API Key"
NVIDIA_API_KEY=

# Required when MODEL_PROVIDER=openai.
# OPENAI_API_KEY=

# --- Write access ---
# Writing to your Google Sheet is OFF unless this is explicitly true. That is
# deliberate: a deployment that forgets to configure anything ends up
# read-only rather than letting any visitor write to your spreadsheet.
#
# Set this for your own local use. Never set it on a public deployment.
WRITE_ENABLED=true

# With writes off, the app also caps messages per browser session (10 by
# default) and forces the free model provider. Override the cap here.
# MAX_MESSAGES_PER_SESSION=10

# TMDB v3 API key (Settings -> API on themoviedb.org).
TMDB_API_KEY=

# Google Sheets service account. Locally this can be a path to the downloaded
# key file; on Streamlit Cloud paste the whole JSON on one line instead.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# The long ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_KEY>/edit
SPREADSHEET_KEY=
