# Secrets — never commit these.
# The trailing * matters: a plain `.streamlit/secrets.toml` does not cover
# copies like secrets.toml.bak, which hold exactly the same credentials.
.env
.env.*
!.env.example
service_account.json
*service-account*.json
.streamlit/secrets.toml*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
